# ---------------------------------------------------------------------------
# F1 Data Project — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Supabase project REST endpoint. Safe to expose — it is a public URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable / anon key. Safe for the API and the browser: Row Level Security
# grants it SELECT only, verified by backend/tests/test_supabase.py. Those tests
# skip unless the two variables below are set, and setting them does not switch
# the running API off SQLite -- see backend/app/supabase_repo.py.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never put these in the frontend, a client bundle, or a
# committed file. They bypass Row Level Security.
# ---------------------------------------------------------------------------

# Direct Postgres connection, used only by the ingestion pipeline
# (backend/etl/supabase_import.py). Contains the database password.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Service-role key. Not required by anything in this repository today; the
# ingestion pipeline uses SUPABASE_DB_URL instead. Listed so its handling is
# unambiguous: server-side only, never logged, never shipped to a client.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Comma-separated CORS allow-list. Never wildcarded.
F1_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Observability. All optional; the app runs with none of them set.
# See docs/OPERATIONS.md section 6.
# ---------------------------------------------------------------------------

# `text` (default, readable locally) or `json` (one object per line, which any
# log aggregator parses without a custom rule). Set json in production.
F1_LOG_FORMAT=text

# Root log level. INFO logs every request; WARNING logs only 4xx, 5xx and slow.
F1_LOG_LEVEL=INFO

# A successful request slower than this is logged at WARNING. The audit's
# slowest known-good endpoint was ~500 ms, so 1000 catches a regression.
F1_SLOW_REQUEST_MS=1000

# Error reporting, off unless set. A DSN is a write-only ingest URL, not a
# credential -- but it only does anything if `sentry-sdk` is installed, which
# is deliberately NOT in requirements.txt. Set with the SDK absent and startup
# logs MISCONFIGURED rather than pretending reporting is on.
# F1_SENTRY_DSN=
# F1_ENVIRONMENT=production
