# Normalise to LF in the repository. Developed on Windows; without this a
# clone on Linux/macOS sees the whole tree as modified.
* text=auto eol=lf

# Binary -- never touch line endings.
*.png binary
*.db  binary

# Source data: byte-for-byte identical in every checkout, no exceptions.
# build_meta.source_sha256 hashes these bytes, so line-ending normalisation
# would make the same commit produce a different database on another platform.
results.csv           -text
backend/etl/circuit_map.csv -text

# The same guarantee, for the source extracts the comment above already
# claimed to cover but did not name. supabase_import.checksum() sha256s these
# bytes and records the result in datasets.checksum, so normalising their line
# endings would change a stored checksum without changing a single value.
# They carry CRLF today and match the repository exactly; -text freezes that
# rather than leaving it to whichever platform next runs `git add`.
data/*.csv            -text

# Migrations are checksummed byte-for-byte in CHECKSUMS.md5, so their line
# endings are part of their identity. Two of them were committed from Windows
# with CRLF while the repository stored LF, which made verify_migrations.py
# fail on every fresh checkout -- including CI -- while passing on the one
# working copy the checksums were generated from. eol=lf forces LF in the
# working tree on every platform, so what is hashed locally is what is
# committed.
supabase/migrations/*.sql text eol=lf
