# Normalise to LF in the repository. Developed on Windows; without this a
# clone on Linux/macOS sees the whole tree as modified.
* text=auto eol=lf

# Binary -- never touch line endings.
*.png binary
*.db  binary

# Source data: byte-for-byte identical in every checkout, no exceptions.
# build_meta.source_sha256 hashes these bytes, so line-ending normalisation
# would make the same commit produce a different database on another platform.
results.csv           -text
backend/etl/circuit_map.csv -text
